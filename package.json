{
  "name": "mangi-world",
  "version": "5.7.0",
  "private": true,
  "description": "Standalone HTML canvas RPG with browser regression tests",
  "scripts": {
    "start": "python3 -m http.server 8000 --bind 127.0.0.1",
    "test": "node --test tests/*.test.cjs",
    "test:save": "node --test tests/save-system.test.cjs",
    "test:session": "node --test tests/session-regression.test.cjs",
    "test:input": "node --test tests/input-regression.test.cjs",
    "test:timing": "node --test tests/timing-regression.test.cjs",
    "test:layout": "node --test tests/layout-regression.test.cjs",
    "test:objectives": "node --test tests/objective-regression.test.cjs",
    "test:equipment": "node --test tests/equipment-regression.test.cjs",
    "test:combat": "node --test tests/combat-regression.test.cjs",
    "test:accessibility": "node --test tests/accessibility-regression.test.cjs",
    "test:admin": "node --test tests/admin-regression.test.cjs",
    "test:graphics": "node --test tests/graphics-regression.test.cjs",
    "test:balance": "node --test tests/balance-regression.test.cjs",
    "test:integration": "node --test tests/integration-regression.test.cjs",
    "test:slime": "node --test tests/slime-regression.test.cjs",
    "test:wolf": "node --test tests/wolf-regression.test.cjs",
    "test:undead": "node --test tests/undead-regression.test.cjs",
    "test:ghost": "node --test tests/ghost-regression.test.cjs",
    "test:demon": "node --test tests/demon-regression.test.cjs",
    "test:monsters": "node --test tests/slime-regression.test.cjs tests/wolf-regression.test.cjs tests/undead-regression.test.cjs tests/ghost-regression.test.cjs tests/demon-regression.test.cjs tests/monster-integration.test.cjs",
    "test:rewards": "node --test tests/rewards-regression.test.cjs",
    "test:traits": "node --test tests/traits-regression.test.cjs",
    "test:presentation": "node --test tests/presentation-regression.test.cjs",
    "test:journal": "node --test tests/journal-regression.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
